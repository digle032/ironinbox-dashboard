# Frontend Firebase values are optional for this Gmail-first implementation.
# To connect a real Gmail inbox, create a Google OAuth "Web application" client,
# enable the Gmail API, and register http://localhost:8787/api/gmail/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8787/api/gmail/callback
FRONTEND_URL=http://localhost:5000
API_PORT=8787
# Generate a unique, long secret for every environment. Never commit .env.
TOKEN_ENCRYPTION_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
